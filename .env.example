# Supabase (required for live data, admin auth, and production checkout)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe — publishable key (safe in the browser bundle)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Stripe — secret key (server only; used by Vite dev plugin + Supabase edge functions)
# NEVER prefix with VITE_ — that would leak the key into the frontend build.
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Stripe webhook signing secret (Supabase edge function only)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Supabase service role (edge functions only — never in the frontend)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
